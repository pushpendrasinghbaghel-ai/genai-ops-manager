{
  "$schema": "./.dt-app/app.config.schema.json",
  "environmentUrl": "https://demo.apps.dynatrace.com/",
  "app": {
    "name": "GenAI Ops Manager",
    "version": "0.0.1",
    "description": "GenAI Ops Manager - Analyze, optimize, and govern your GenAI workloads",
    "id": "my.genai.ops.manager",
    "scopes": [
      { "name": "storage:logs:read", "comment": "Read logs from Grail" },
      { "name": "storage:buckets:read", "comment": "Read bucket data" },
      { "name": "storage:spans:read", "comment": "Read GenAI spans from Grail" },
      { "name": "storage:events:read", "comment": "Read events from Grail" },
      { "name": "storage:metrics:read", "comment": "Read metrics" }
    ],
    "entryPoints": [
      {
        "type": "ui",
        "location": "sidebar",
        "id": "genai-ops-manager",
        "name": "GenAI Ops Manager",
        "description": "Monitor and optimize GenAI workloads",
        "icon": "artificial-intelligence",
        "path": "/ui"
      }
    ]
  }
}